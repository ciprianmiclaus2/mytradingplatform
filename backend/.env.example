# Copy to backend/.env to override defaults. Real environment variables take precedence.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# "~" expands to your home directory; relative paths resolve against the project root.
DATA_DIR=~/mytradingplatform/data
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_TIMEOUT=30
CURRENT_PRICE_ARCHIVE_THRESHOLD=100000
BACKUP_RETENTION_COUNT=10
# JSON list of browser origins allowed to call the API directly.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
