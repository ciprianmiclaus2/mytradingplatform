# Base URL the browser uses for API calls. "/api" goes through the Vite dev proxy.
# Set to e.g. http://127.0.0.1:8000/api to call the backend directly (CORS must allow the origin).
VITE_API_BASE_URL=/api

# Backend origin the Vite dev server proxies /api requests to.
VITE_BACKEND_URL=http://127.0.0.1:8000
